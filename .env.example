# Copy to .env and change before running docker compose.
# JWT_SECRET must be base64 of at least 32 random bytes, e.g.:  openssl rand -base64 48
JWT_SECRET=
DB_PASSWORD=bloodnet
MYSQL_ROOT_PASSWORD=rootpass
CORS_ORIGINS=http://localhost:8081
# Demo users (admin/staff1/staff2/hospital @bloodnet.local). Turn off for a real deployment.
SEED_DEMO_USERS=true
SEED_PASSWORD=Bloodnet@123
# First admin account, created at startup if the email isn't registered yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Setup code for the "Create admin account" page (12+ characters). Leave empty to turn sign-up off.
ADMIN_SIGNUP_CODE=
